{
  "name": "discordjs-v14-typescript-handler",
  "version": "2.4.1",
  "description": "A modern, production-ready TypeScript handler for discord.js v14",
  "main": "src/index.ts",
  "types": "handler/typings.d.ts",
  "type": "module",
  "private": true,
  "author": "Bullet_Tide",
  "license": "MIT",
  "scripts": {
    "start": "tsc && node dist/src/index.js",
    "build": "tsc -w",
    "pm2:start": "tsc && pm2 start dist/src/index.js --name dtsbot --attach",
    "pm2:stop": "pm2 stop dist/src/index.js",
    "pm2:restart": "pm2 stop dist/src/index.js && tsc && pm2 start dist/src/index.js --name dtsbot --attach"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BulletTide/djs-typescript-handler.git"
  },
  "bugs": {
    "url": "https://github.com/BulletTide/djs-typescript-handler/issues"
  },
  "homepage": "https://github.com/BulletTide/djs-typescript-handler#readme",
  "dependencies": {
    "discord.js": "^14.25.1",
    "mongoose": "^5.13.23"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "pm2": "^5.4.3",
    "typescript": "^5.9.3"
  }
}